# ==============================================================================
# MedGraph Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RETRIEVAL MODE CONFIGURATION
# ------------------------------------------------------------------------------
# Options:
#   - "mock": Deterministic in-memory synthetic clinical store for fast offline tests & demo
#   - "hybrid_live": Direct native Neo4j (Cypher) + local persistent dense vector search (FastEmbed)
#   - "external_api": Proxies retrieval calls to Person 1's Express backend over HTTP
RETRIEVAL_MODE=mock

# ------------------------------------------------------------------------------
# 2. NATIVE NEO4J DATABASE (Used when RETRIEVAL_MODE=hybrid_live)
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT=5.0

# ------------------------------------------------------------------------------
# 3. NATIVE VECTOR SEMANTIC SEARCH (Used when RETRIEVAL_MODE=hybrid_live)
# ------------------------------------------------------------------------------
VECTOR_MODEL_NAME=BAAI/bge-small-en-v1.5
VECTOR_INDEX_PATH=data/vector_store.json

# ------------------------------------------------------------------------------
# 4. EXTERNAL BACKEND API (Used when RETRIEVAL_MODE=external_api)
# ------------------------------------------------------------------------------
API_BASE_URL=http://localhost:5000
GRAPH_SEARCH_ENDPOINT=/api/graph/search
VECTOR_SEARCH_ENDPOINT=/api/vector/search
ADMISSION_ENDPOINT=/api/patients/{patient_id}/admissions

# ------------------------------------------------------------------------------
# 5. LLM CONFIGURATION ("mock" | "openai" | "google_genai" | "anthropic")
# ------------------------------------------------------------------------------
LLM_PROVIDER=mock
TEMPERATURE=0.0

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 6. WORKFLOW & DIAGNOSTICS
# ------------------------------------------------------------------------------
MAX_RETRIES=2
LOG_LEVEL=INFO
